rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Organisatoren stehen in der Sammlung „admins“ (Dokument-ID = Google-Adresse in Kleinbuchstaben).
    // Den ersten Eintrag (dich) legst du einmal in der Firebase-Konsole an, siehe ANLEITUNG Schritt 3.
    // role: 'owner' = Leitung (darf Organisatoren verwalten), 'co' = Mitorganisator.
    function adminDoc() {
      return /databases/$(database)/documents/admins/$(request.auth.token.email.lower());
    }
    function isAdmin() {
      return request.auth != null
        && request.auth.token.get('email', null) is string
        && request.auth.token.get('email_verified', false) == true
        && exists(adminDoc());
    }
    function isLead() {
      return isAdmin() && get(adminDoc()).data.role == 'owner';
    }

    // Persönlicher Nachzügler-Link (Code steht in der Antwort als "pass")
    function passOk(pollId) {
      let code = request.resource.data.get('pass', '');
      return code is string && code.matches('^[a-z0-9]{6,40}$')
        && exists(/databases/$(database)/documents/polls/$(pollId)/passes/$(code))
        && get(/databases/$(database)/documents/polls/$(pollId)/passes/$(code)).data.until > request.time.toMillis();
    }

    // Teilnehmerliste: aus = alle mit Link; an = nur Personen auf der Liste (oder mit Nachzügler-Link)
    function participantOk(p, pollId, uid) {
      return p.get('restricted', false) != true
        || p.get('participants', {}).get(uid, {}).get('on', false) == true
        || passOk(pollId);
    }

    // Offen für alle  ODER  persönlich freigeschaltet  ODER  gültiger Nachzügler-Link
    function openFor(p, pollId, uid) {
      let now = request.time.toMillis();
      return (p.get('closed', false) != true && (p.get('closesAt', null) == null || now < p.get('closesAt', 0)))
        || p.get('extensions', {}).get(uid, {}).get('until', 0) > now
        || passOk(pollId);
    }

    function validNotify() {
      let d = request.resource.data;
      return d.types is map && d.types.size() <= 20
        && (!('discord' in d) || d.discord == null || (d.discord is map && d.discord.id is string && d.discord.id.size() <= 32))
        && (!('push' in d) || (d.push is list && d.push.size() <= 10))
        && (!('cal' in d) || d.cal == null || (d.cal is map && d.cal.token is string && d.cal.token.matches('^[a-z0-9]{24,40}$')));
    }

    function canWrite(pollId, uid) {
      let p = get(/databases/$(database)/documents/polls/$(pollId)).data;
      return participantOk(p, pollId, uid) && openFor(p, pollId, uid);
    }

    // Absagen (oder Absage zurücknehmen) geht auch nach Fristende
    function onlyCancelChange() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancel', 'updatedAt']);
    }

    function validResponse() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.days is map
        && d.rules is list && d.rules.size() <= 30
        && (!('note' in d) || (d.note is string && d.note.size() <= 300))
        && (!('emoji' in d) || (d.emoji is string && d.emoji.size() <= 16))
        && (!('pass' in d) || (d.pass is string && d.pass.size() <= 40))
        && (!('cancel' in d) || d.cancel == null || d.cancel is map)
        && (!('favs' in d) || (d.favs is list && d.favs.size() <= 3));
    }

    // Teilnehmer schlägt einen neuen Zeitraum vor ("Ich kann an keinem Tag").
    // Darf nur den eigenen Eintrag unter "added" ändern, sonst nichts am Event.
    function proposeRange(pollId, uid) {
      let mode = resource.data.get('addMode', 'auto');
      let e = request.resource.data.added[uid];
      return mode != 'off'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['added'])
        && request.resource.data.added.diff(resource.data.get('added', {})).affectedKeys().hasOnly([uid])
        && e.from is string && e.to is string
        && e.from.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && e.to.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && e.from <= e.to
        && e.name is string && e.name.size() <= 40
        && e.ok == (mode == 'auto')
        && participantOk(resource.data, pollId, uid)
        && openFor(resource.data, pollId, uid)
        && exists(/databases/$(database)/documents/polls/$(pollId)/responses/$(uid));
    }

    match /polls/{pollId} {
      // Wer den Link hat, darf genau dieses eine Event lesen (Titel, Zeitraum, Frist, festgelegter Termin).
      allow get: if request.auth != null;
      // Liste aller Events, Anlegen, Löschen: nur Organisatoren.
      allow list, create, delete: if isAdmin();
      // Ändern: Organisatoren – oder ein Teilnehmer, der nur seinen eigenen Zeitraum-Vorschlag einträgt.
      allow update: if isAdmin() || (request.auth != null && proposeRange(pollId, request.auth.uid));

      match /responses/{uid} {
        // Jeder sieht nur seine eigene Antwort – Organisatoren sehen alle.
        allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
        allow create: if request.auth != null && request.auth.uid == uid && validResponse()
                      && (isAdmin() || canWrite(pollId, uid));
        allow update: if request.auth != null && request.auth.uid == uid && validResponse()
                      && (isAdmin() || onlyCancelChange() || canWrite(pollId, uid));
        allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      }

      // Nachzügler-Links: nur Organisatoren legen sie an und sehen die Liste.
      // Wer den Code kennt, darf genau diesen einen Eintrag lesen (um die Gültigkeit zu sehen).
      match /passes/{code} {
        allow get: if request.auth != null;
        allow list, create, update, delete: if isAdmin();
      }

      // Teilnahme-Anfragen bei Events mit Teilnehmerliste
      match /requests/{uid} {
        allow get: if isAdmin() || (request.auth != null && request.auth.uid == uid);
        allow list: if isAdmin();
        allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40;
      }
    }

    // Organisatoren: alle Organisatoren sehen die Liste, nur die Leitung ändert sie.
    // Mitorganisatoren dürfen sich selbst austragen.
    match /admins/{email} {
      allow read: if isAdmin();
      allow create, update: if isLead()
        && email == email.lower()
        && request.resource.data.role in ['owner', 'co']
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 40));
      allow delete: if isLead() || (isAdmin() && email == request.auth.token.email.lower());
    }

    // Eigene Vorlagen für neue Events: nur Organisatoren.
    match /templates/{id} {
      allow read, write: if isAdmin();
    }

    // Benachrichtigungs-Einstellungen: nur die Person selbst. Verschickt wird von GitHub Actions (Admin-Zugang).
    match /notify/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid && validNotify();
    }
    // Versand-Protokoll: nur für den Versand-Dienst, keine App hat Zugriff.
    match /notifyLog/{id} {
      allow read, write: if false;
    }
    match /notifyMeta/{id} {
      allow read, write: if false;
    }

    // Privates Verzeichnis jeder Person („Meine Events“, zum Übernehmen von Terminen).
    // Nur die Person selbst kann es lesen oder schreiben – auch Organisatoren nicht.
    match /members/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.polls is map && request.resource.data.polls.size() <= 300
        && (!('name' in request.resource.data)
            || (request.resource.data.name is string && request.resource.data.name.size() <= 40));
    }
  }
}
